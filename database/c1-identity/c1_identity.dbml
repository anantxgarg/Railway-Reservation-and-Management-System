// C1 Identity and Access — as implemented in schema.sql (+ proposed token tables)
// Paste into https://dbdiagram.io/d to view.
// Approved part matches schema_relational.dbml section C1 exactly in names and keys;
// it adds NOT NULL / defaults / checks that the master DBML left unspecified.

Project railway_c1 {
  database_type: 'PostgreSQL'
}

enum role_name_enum {
  CUSTOMER
  STAFF
  ADMIN
}

enum user_status_enum {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  LOCKED
}

Table roles {
  role_id int [pk, increment]
  role_name role_name_enum [not null, unique]
  description text
  created_at timestamp [not null, default: `now()`]
}

Table permissions {
  permission_id int [pk, increment]
  permission_name varchar(100) [not null, unique, note: 'UPPER_SNAKE_CASE']
  description text
}

Table role_permissions {
  role_id int [not null]
  permission_id int [not null]
  indexes {
    (role_id, permission_id) [pk]
  }
}

Table users {
  user_id int [pk, increment]
  role_id int [not null]
  name varchar(100) [not null]
  email varchar(255) [not null, unique, note: 'stored lower-case + trimmed (CHECK)']
  phone varchar(20) [note: '^\+?[0-9]{10,15}$']
  password_hash varchar(255) [not null, note: 'bcrypt only (CHECK)']
  status user_status_enum [not null, default: 'ACTIVE']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`, note: 'trigger keeps current']
  last_login_at timestamp
  failed_login_attempts int [not null, default: 0]
}

Table staff {
  staff_id int [pk, increment]
  user_id int [not null, unique]
  department varchar(100) [not null]
  location varchar(150) [not null]
  Note: 'Trigger: user must have role STAFF.'
}

// ---- PROPOSED (not yet in the master schema) ----
Table refresh_tokens {
  token_id int [pk, increment]
  user_id int [not null]
  token_hash char(64) [not null, unique, note: 'hex SHA-256']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  revoked_at timestamp
  replaced_by int
  Note: 'PROPOSED — needs team approval'
}

Table password_reset_tokens {
  reset_id int [pk, increment]
  user_id int [not null]
  token_hash char(64) [not null, unique, note: 'hex SHA-256']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  used_at timestamp
  Note: 'PROPOSED — needs team approval'
}

Ref: users.role_id > roles.role_id [delete: restrict]
Ref: staff.user_id - users.user_id [delete: cascade]
Ref: role_permissions.role_id > roles.role_id [delete: cascade]
Ref: role_permissions.permission_id > permissions.permission_id [delete: cascade]
Ref: refresh_tokens.user_id > users.user_id [delete: cascade]
Ref: refresh_tokens.replaced_by > refresh_tokens.token_id [delete: set null]
Ref: password_reset_tokens.user_id > users.user_id [delete: cascade]

TableGroup identity_and_access {
  roles
  permissions
  role_permissions
  users
  staff
}

TableGroup proposed_auth_tokens {
  refresh_tokens
  password_reset_tokens
}
