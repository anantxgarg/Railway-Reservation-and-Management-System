<?xml version="1.0" encoding="UTF-8"?>
<!--
	pom.xml = the "shopping list" for Maven (the Java build tool).
	It says which libraries (dependencies) this project needs and which Java version to use.
	Run the app with:  ./mvnw spring-boot:run   (or mvnw.cmd spring-boot:run on Windows)

	Spring Boot 3 + Java 17: the same versions the other teams use.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- The Spring Boot "parent" picks compatible versions for every Spring library below,
	     so we don't have to write version numbers ourselves. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/>
	</parent>

	<groupId>com.railway</groupId>
	<artifactId>team6-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>team6-backend</name>
	<description>Team 6 - Notifications and Feedback backend (Spring Boot + MongoDB)</description>

	<properties>
		<java.version>17</java.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>
		<!-- Web: lets us write REST controllers (@RestController, @GetMapping, ...) and runs a Tomcat web server. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- MongoDB: connects to MongoDB and gives us "repositories" that save/find documents for us. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>

		<!-- Validation: lets us put rules like @NotBlank or @Min(1) on request fields
		     and have Spring reject bad requests automatically. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Security: checks the login token (JWT) that Team 1's backend gives users, so we know
		     who is asking without them typing their userId. Same library as booking-service. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Tests: JUnit, MockMvc (calls our URLs without starting a real server). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Adds the "spring-boot:run" command and builds a runnable .jar file. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
