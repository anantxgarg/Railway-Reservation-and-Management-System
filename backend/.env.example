# ──────────────────────────────────────────────────────────────────────────────
# C1 Authentication Backend — Environment Variables
# Copy to .env and fill in real values.  NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=railway
PGUSER=postgres
PGPASSWORD=change_me

# ── MongoDB (audit_log) ─────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/railway

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m

# ── Refresh token ────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Password reset token ─────────────────────────────────────────────────────
RESET_TOKEN_EXPIRES_MINUTES=60
# DEV ONLY, default false. When true, POST /forgot-password also returns the raw
# reset token in API responses. The server REFUSES TO START if
# this is true and NODE_ENV is not development/test. Never log or enable in prod.
DEV_EXPOSE_RESET_TOKEN=false

# ── Email Delivery (Brevo Transactional API) ─────────────────────────────────
# Get your API key from Brevo: Settings -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM="Railway Reservation" <noreply@yourdomain.com>
# Optional: frontend base URL for clickable password reset link (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# ── Account lockout ──────────────────────────────────────────────────────────
# How many consecutive failures before the account is LOCKED
LOGIN_LOCKOUT_THRESHOLD=5

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production, set this to the actual frontend origin, e.g. https://railway.example.com
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20       # register, login, forgot-password, change-password (per IP / window)
RATE_LIMIT_MAX_REFRESH=60    # refresh
RATE_LIMIT_MAX_RESET=10      # reset-password

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Leave UNSET when clients connect directly (X-Forwarded-For is then ignored, so
# it cannot be spoofed). Behind a reverse proxy set EXACTLY ONE of:
#   TRUST_PROXY=1                      # one proxy hop in front of the app (e.g. nginx)
#   TRUST_PROXY=10.0.0.5,10.0.1.0/24   # only these proxy addresses/CIDRs
#   TRUST_PROXY=loopback               # proxy on the same host
# "true" and "*" are rejected at startup.
# TRUST_PROXY=
